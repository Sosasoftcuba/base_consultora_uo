# ==========================================
# CONFIGURACIÓN DE SEGURIDAD Y ACCESO
# ==========================================

# 1. Desactivar el listado de directorios (Evita que vean tus archivos)
Options -Indexes

# 2. Ocultar la firma del servidor
ServerSignature Off

# 3. Redirigir los errores a tu página personalizada 404.html
# El 404 es para páginas que no existen.
# El 403 es para cuando alguien intenta entrar a una carpeta directamente.
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# 4. Bloquear acceso a archivos sensibles
<FilesMatch "^\.|(\.env|\.ini|\.log|\.bak|\.zip|\.sql|\.json|\.lock|composer\.(json|lock)|package\.json)$">
    Require all denied
</FilesMatch>

# 5. Bloquear acceso directo a carpetas de sistema (Para cuando uses PHP)
RedirectMatch 403 ^/includes/.*$
RedirectMatch 403 ^/config/.*$

# 6. Cabeceras de Seguridad HTTP
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 7. Forzar HTTPS (Cuando tengas certificado SSL en tu hosting)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 8. Optimización de caché
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>